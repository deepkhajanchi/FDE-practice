GOOGLE_CLOUD_PROJECT=<YOUR_PROJECT_ID>
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
MODEL=gemini-3.5-flash
SALESFORCE_DOMAIN=<YOUR_ORG>.my.salesforce.com
SALESFORCE_AUTH_PROVIDER_URI=projects/<YOUR_PROJECT_ID>/locations/us-central1/authProviders/salesforce-auth-provider
# Optional: Vertex AI Memory Bank Engine ID (in us-central1)
# MEMORY_BANK_ID=<YOUR_MEMORY_BANK_ID>
# MEMORY_BANK_LOCATION=us-central1
