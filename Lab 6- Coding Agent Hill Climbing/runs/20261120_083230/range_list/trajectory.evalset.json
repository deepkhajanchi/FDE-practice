                      "function_call": {
                        "id": "call_5775839715208798306",
                        "args": {
                          "path": "src/expand.py",
                          "contents": "import sys\n\ndef expand_range(item):\n    \"\"\"Expands a range 'a-b' into a list of integers or returns [n] for a single integer.\"\"\"\n    if '-' in item:\n        try:\n            start, end = map(int, item.split('-'))\n            return list(range(start, end + 1))\n        except ValueError:\n            return []\n    else:\n        try:\n            return [int(item)]\n        except ValueError:\n            return []\n\ndef main():\n    # Read one line from stdin\n    input_data = sys.stdin.read().strip()\n    \n    if not input_data:\n        return\n\n    # Split by comma to get individual items\n    items = input_data.split(',')\n    \n    results = []\n    for item in items:\n        results.extend(expand_range(item.strip()))\n    \n    # Print results space-separated\n    print(*(results))\n\nif __name__ == \"__main__\":\n    main()\n"
