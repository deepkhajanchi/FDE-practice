                          "path": "test_intervals.py",
                          "contents": "import subprocess\n\ndef run_test(command, input_str, expected_output, expected_exit_code=0):\n    process = subprocess.Popen(\n        ['python', 'src/intervals.py'] + command.split(),\n        stdin=subprocess.PIPE,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        text=True\n    )\n    stdout, stderr = process.communicate(input=input_str)\n    \n    if process.returncode != expected_exit_code:\n        print(f\"Test failed: Expected exit code {expected_exit_code}, got {process.returncode}\")\n        print(f\"Stderr: {stderr}\")\n        return False\n    \n    if stdout.strip() != expected_output.strip():\n        print(f\"Test failed: Expected output '{expected_output}', got '{stdout.strip()}'\")\n        return False\n    \n    return True\n\ninput_data = \"0 2.675\\n5 6\"\nprint(f\"Merge test: {run_test('merge', input_data, '0 2.675\\n5 6')}\")\nprint(f\"Count test: {run_test('count', input_data, '2')}\")\nprint(f\"Length test: {run_test('length', input_data, '3.68')}\")\nprint(f\"Covers 2 test: {run_test('covers 2', input_data, 'yes')}\")\nprint(f\"Covers 4 test: {run_test('covers 4', input_data, 'no')}\")\n\n# Test touching intervals\ninput_data_touch = \"1.5 3.5\\n3.5 4.0\"\nprint(f\"Merge touch test: {run_test('merge', input_data_touch, '1.5 4')}\")\n\n# Test error handling\nprint(f\"Malformed input test: {run_test('merge', '1 2\\n3', '', 2)}\")\nprint(f\"Invalid command test: {run_test('invalid', '1 2', '', 2)}\")\n"
