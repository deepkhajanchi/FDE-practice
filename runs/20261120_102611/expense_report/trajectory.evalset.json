                          "contents": "import subprocess\n\ndef run_ledger(input_data, args):\n    process = subprocess.Popen(\n        ['python3', 'src/ledger.py'] + args,\n        stdin=subprocess.PIPE,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        text=True\n    )\n    stdout, stderr = process.communicate(input=input_data)\n    return process.returncode, stdout, stderr\n\nrecords = \"\"\"2026-01-05,food,10.00\n2026-02-03,food,5.005\n2026-01-20,rent,800\n\"\"\"\n\n# Test total\ncode, out, err = run_ledger(records, ['total'])\nprint(f\"Total: {out.strip()} (Code: {code})\")\nassert out.strip() == \"815.01\"\n\n# Test categories\ncode, out, err = run_ledger(records, ['categories'])\nprint(f\"Categories:\\n{out.strip()}\")\nexpected_categories = \"rent: 800.00\\nfood: 15.01\"\nassert out.strip() == expected_categories\n\n# Test category food\ncode, out, err = run_ledger(records, ['category', 'food'])\nprint(f\"Category food: {out.strip()} (Code: {code})\")\nassert out.strip() == \"15.01\"\n\n# Test category travel (should fail)\ncode, out, err = run_ledger(records, ['category', 'travel'])\nprint(f\"Category travel: {out.strip()} (Code: {code})\")\nassert code == 1\n\n# Test malformed line\ncode, out, err = run_ledger(\"2026-01-05,food\\n\", ['total'])\nprint(f\"Malformed line: {err.strip()} (Code: {code})\")\nassert code == 2\n\nprint(\"All tests passed!\")\n",
                          "path": "test_ledger.py"
                        },
                        "name": "write_file"
                      },
